# PWA service worker timing (client-exposed via DEVUTILS_ prefix)
DEVUTILS_SW_REFRESH_INTERVAL_MS=1000
DEVUTILS_SW_UPDATE_ON_LOAD_WINDOW_MS=10000

# Login with ChatGPT — server-only session cookie signing secret
# Generate with: openssl rand -hex 32
LWC_SECRET=

# Upstash Redis (required in production) — persists ChatGPT sessions across Vercel instances
# Create a free database at https://console.upstash.com and copy REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
